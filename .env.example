# Copy to .env and fill in. .env is gitignored.
# Every value here is Hedera TESTNET only. Never put a mainnet key in this file.

HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_ACCOUNT_ID=0.0.YOUR_ACCOUNT

# ---------------------------------------------------------------------------
# Keys. All three scripts read different ones, so fill in all three.
# Accounts must be ECDSA, not ED25519, or they cannot drive an EVM RPC at all.
# ---------------------------------------------------------------------------

# Used by 01_DeployPeriphery.s.sol and 02_WireBond.s.sol (the bond issuer account).
PRIVATE_KEY=

# Used by TestnetFlow.s.sol. The lender signs quotes off-chain and deploys;
# the borrower is the only account that broadcasts openRepo.
LENDER_PRIVATE_KEY=
BORROWER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# TestnetFlow.s.sol. Change REQUEST_ID for EVERY new trade: a requestId opens
# exactly once, so reusing one makes openRepo revert with RequestIdUsed.
# ---------------------------------------------------------------------------
REQUEST_ID=repo-1

# Printed by deployAll(). Stage 1 = MockATS and MockERC20.
TENOR_SETTLEMENT=
SECURITY=
CASH=

# ---------------------------------------------------------------------------
# Already deployed on Hedera testnet
# ---------------------------------------------------------------------------
ATS_BOND=0xc2dadb01462b766bb2f58c9638b32e97200ca07d
SCHEDULE_PROBE=0x3102F4Bcba8F781B6d7cf697A5af32EE829A1438

# Filled in by script/01_DeployPeriphery.s.sol
TENOR_IDENTITY_REGISTRY=
TENOR_COMPLIANCE=

# Stage 2 only: USDC on Hedera testnet (HTS token, ERC-20 facade address).
USDC=
